{
  "name": "server",
  "type": "module",
  "main": "src/index.ts",
  "scripts": {
    "build": "tsdown",
    "check-types": "tsc --noEmit",
    "compile": "bun build --compile --no-compile-autoload-dotenv --minify --sourcemap --bytecode ./src/index.ts --outfile server",
    "dev": "bun run --hot src/index.ts",
    "start": "bun run dist/index.mjs",
    "env:generate": "varlock codegen",
    "auth:generate": "varlock run -- bun x auth@latest generate --config src/services.ts --output ../../packages/db/src/schema/auth.ts --yes"
  },
  "dependencies": {
    "@chimera2/api": "workspace:*",
    "@chimera2/auth": "workspace:*",
    "@chimera2/db": "workspace:*",
    "@fastify/cors": "^11.3.0",
    "@hono/trpc-server": "^0.4.2",
    "@trpc/server": "catalog:",
    "better-auth": "catalog:",
    "evlog": "^2.28.1",
    "fastify": "^5.12.3",
    "libsql": "catalog:",
    "varlock": "catalog:",
    "ws": "^8.22.0",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@chimera2/config": "workspace:*",
    "@types/bun": "catalog:",
    "@types/ws": "^8.18.2",
    "tsdown": "^0.23.0",
    "typescript": "catalog:"
  }
}
